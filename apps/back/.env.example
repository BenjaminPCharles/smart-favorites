# Hugging Face inference token, used by the embedding service
HF_TOKEN=

# HTTP server
API_PORT=3000
# Comma separated list of allowed origins.
# Add your unpacked extension id here, e.g.:
#   http://localhost:3000,chrome-extension://abcdefghijklmnopabcdefghijklmnop
CORS_ORIGIN=http://localhost:3000

# Number of proxies you control between the client and this server, so the per-IP
# auth rate limits key on the real client instead of the proxy. `0` or empty ignores
# X-Forwarded-For — what you want when the server is directly exposed, since the
# header is client-controlled. `1` behind a single nginx/Traefik, `2` with a CDN in
# front of it. Count too high and the header becomes spoofable one hop at a time, so
# only raise it for a proxy that actually overwrites or appends X-Forwarded-For.
# A hop count only: anything else (`true`, `1.5`) fails at startup.
TRUST_PROXY=0

# Main application database
SERVICE_DB_HOST=localhost
SERVICE_DB_PORT=5432
SERVICE_DB_USER=
SERVICE_DB_PASSWORD=
SERVICE_DB_NAME=
