# Hugging Face inference token, used by the embedding service
HF_TOKEN=

# HTTP server
API_PORT=3000
# Comma separated list of allowed origins.
# Add your unpacked extension id here, e.g.:
#   http://localhost:3000,chrome-extension://abcdefghijklmnopabcdefghijklmnop
CORS_ORIGIN=http://localhost:3000

# Set ONLY when a reverse proxy you control sits in front, so the per-IP auth rate
# limits key on the real client instead of the proxy. Accepts `true`, a hop count
# (`1`), or a CIDR list. Left empty, X-Forwarded-For is ignored — which is what you
# want when the server is directly exposed, since the header is client-controlled.
TRUST_PROXY=

# Main application database
SERVICE_DB_HOST=localhost
SERVICE_DB_PORT=5432
SERVICE_DB_USER=
SERVICE_DB_PASSWORD=
SERVICE_DB_NAME=

# Scraping database
SCRAPE_DB_HOST=localhost
SCRAPE_DB_PORT=5432
SCRAPE_DB_USER=
SCRAPE_DB_PASSWORD=
SCRAPE_DB_NAME=
